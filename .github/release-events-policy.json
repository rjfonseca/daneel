{
  "name": "Trusted release and semantic PR events",
  "enforcement": "active",
  "conditions": {
    "workflow_path": {
      "include": [".github/workflows/release.yml", ".github/workflows/semantic-pull-request.yml"],
      "exclude": []
    }
  },
  "rules": [{
    "type": "restrict_action_events",
    "parameters": {"allowed_events": ["pull_request_target", "workflow_dispatch"]}
  }]
}
